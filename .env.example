# ============================================================
# WAFT MAM Farms — Environment Variables
# ============================================================
# Copy this file to `.env` (local) or set these in your Vercel
# project settings (Production, Preview, and Development envs).
# ============================================================

# --- DATABASE (PostgreSQL on Neon) ---
# Get these from https://neon.tech after creating a free project.
# In your Neon dashboard, click "Connect" → choose "Pooled connection"
# for DATABASE_URL and "Direct connection" for DIRECT_URL.

# Pooled connection (used by the app at runtime — required by Vercel serverless)
DATABASE_URL="postgresql://USER:PASSWORD@ep-pool-XXX.region.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection (used by Prisma Migrations only)
DIRECT_URL="postgresql://USER:PASSWORD@ep-direct-XXX.region.aws.neon.tech/DBNAME?sslmode=require"

# --- NODE ENV ---
NODE_ENV="production"
