# Local development placeholder — set real PostgreSQL connection strings before running migrations.
# For Neon (recommended): https://neon.tech — create a free project, copy pooled + direct URLs.
# For Supabase: https://supabase.com — create a project, copy connection string from Settings > Database.
#
# DATABASE_URL must be the POOLED connection (for runtime queries).
# DIRECT_URL must be the DIRECT connection (for migrations).
#
# Example:
# DATABASE_URL="postgresql://user:pass@ep-pool.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:pass@ep-direct.region.aws.neon.tech/dbname?sslmode=require"

DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder?sslmode=disable"
DIRECT_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder?sslmode=disable"
